      <input x="256.0" y="630" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_CTRL" />
      <input x="244" y="295" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="Q0.0" />
      <input x="336.0" y="658" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_CTRL" />
      <input x="324" y="295" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="Q0.1" />
      <input x="416.0" y="686" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_CTRL" />
      <input x="404" y="295" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="Q0.2" />
      <input x="496.0" y="714" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_CTRL" />
      <input x="484" y="295" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="Q0.3" />
      <input x="55" y="735" rotation="0" font="Arial,9,-1,5,50,0,0,0,0,0" text="D1: dioda gasząca K1, katoda do A1 (+).&#10;Y1: ochrona przepięciowa wg wykonania cewki.&#10;H1 zielona PRACA • H2 czerwona AWARIA." />
      <input x="620" y="350" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="Q0.0 MOTOR_CMD → K1&#10;K1: Finder 62.32.9.024.4800&#10;Cewka 24 V DC, symbol ogólny.&#10;Styk mocy K1: tor po prawej." />
      <input x="620" y="440" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="Q0.1 VALVE_EXT → Y1&#10;Y1: Festo VUVG-L10-M52-RT-M5-1P3&#10;Zawór 5/2 monostabilny, cewka 24 V DC.&#10;Siłownik: ADN-20-50-A-P-A; Ø20, skok 50 mm.&#10;B2 schowany / B3 wysunięty → arkusz 2." />
      <input x="620" y="535" rotation="0" font="Arial,9,-1,5,50,0,0,0,0,0" text="Q0.2 LAMP_RUN → H1 • Q0.3 LAMP_FAULT → H2" />
      <input x="620" y="580" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="KSR1: styki funkcjonalne zezwolenia /4.&#10;E-STOP rozłącza K1 i Y1 sprzętowo.&#10;Odbiór bezpieczny pneumatyki przez YS1 /4." />
      <input x="1040" y="145" rotation="0" font="Arial,11,-1,5,50,0,0,0,0,0" text="TOR MOCY NAPĘDU 24 V DC" />
      <input x="1116.0" y="180" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="+24V_MOTOR / X2:3 /1" />
      <input x="1116.0" y="650" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_MOTOR / X2:4 /1" />
      <input x="1170" y="500" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="24 V DC&#10;~60 W&#10;~60 obr./min" />
      <input x="1030" y="720" rotation="0" font="Arial,9,-1,5,50,0,0,0,0,0" text="F2 na ark. 1.&#10;Tor KSR1: wykonanie i obciążalność DC&#10;do doboru; w razie potrzeby stycznik&#10;bezpieczeństwa z kontrolą sprzężenia." />
      <input x="670" y="745" rotation="0" font="Arial,9,-1,5,50,0,0,0,0,0" text="B4-TX • nadajnik bariery E3Z-T81" />
      <input x="706" y="710" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="BN +" />
      <input x="706" y="670" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="+24V_CTRL" />
      <input x="866" y="710" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="BU −" />
      <input x="866" y="670" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_CTRL" />
    </inputs>
