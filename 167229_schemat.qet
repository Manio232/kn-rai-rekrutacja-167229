      <input x="956.0" y="190" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="+24V_CTRL / X2:1 /1" />
      <input x="956.0" y="520" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="0V_CTRL / X2:2 /1" />
      <input x="1010" y="380" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="YS1 24 V DC&#10;Odcięcie i odpowietrzenie&#10;bez napięcia. Model do doboru." />
      <input x="1266.0" y="190" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="+24V_CTRL" />
      <input x="1266" y="410" rotation="0" font="Arial,8,-1,5,50,0,0,0,0,0" text="SAFETY_OK → I0.3 /2" />
      <input x="1180" y="475" rotation="0" font="Arial,9,-1,5,50,0,0,0,0,0" text="Styk informacyjny.&#10;PLC nie realizuje&#10;funkcji E-STOP." />
      <input x="880" y="590" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="Pozostałe tory KSR1 na ark. 3:&#10;• odcięcie toru mocy silnika,&#10;• odebranie zezwolenia K1,&#10;• odebranie zezwolenia Y1.&#10;Liczba styków / rozszerzenie: do doboru.&#10;Nie przypisano fikcyjnych zacisków PNOZ." />
      <input x="55" y="755" rotation="0" font="Arial,10,-1,5,50,0,0,0,0,0" text="Po E-STOP: odblokowanie S0 → RESET S3 → dopiero nowy START S1.&#10;Program PLC musi kasować żądania ruchu po E-STOP, STOP i zaniku zasilania; RESET nie uruchamia cyklu.&#10;Przed doborem YS1 potwierdzić bezpieczny stan siłownika i zachowanie przy ponownym podaniu ciśnienia." />
      <input x="55" y="830" rotation="0" font="Arial,9,-1,5,50,0,0,0,0,0" text="Układ bezpieczeństwa przedstawiono funkcjonalnie. Ostateczna kategoria/PL wymaga oceny ryzyka zgodnie z wymaganiami dla konkretnej maszyny." />
    </inputs>
